# Layer-merging configuration template.
# Copy to `.env` (`make env`) and edit. Every variable is OPTIONAL — Config
# (src/config/default.py) already has the values below baked in; set one here
# only to override it. Values are parsed as Python literals, so:
#   strings   -> "residual"
#   ints      -> 42
#   floats    -> 1e-3
#   tuples    -> "(256, 256)"

# ---- Model ----------------------------------------------------------------
LAYER_MERGING_HIDDEN_DIMS="(256, 256, 256, 256)"
LAYER_MERGING_NUM_CLASSES=10
LAYER_MERGING_INPUT_DIM=784
LAYER_MERGING_DROPOUT=0.0
LAYER_MERGING_MODEL_ARCH="residual"
LAYER_MERGING_BRANCH_SCALE=0.1

# ---- Data (downloads are env-controlled, not global) -----------------------
LAYER_MERGING_DATA_DIR="data"
LAYER_MERGING_MNIST_MIRROR="https://ossci-datasets.s3.amazonaws.com/mnist/"
LAYER_MERGING_BATCH_SIZE=128
LAYER_MERGING_VAL_SIZE=6000

# ---- Training -------------------------------------------------------------
LAYER_MERGING_SEED=42
LAYER_MERGING_SEEDS="(42, 7, 2026)"
LAYER_MERGING_EPOCHS=6
LAYER_MERGING_LR=1e-3
LAYER_MERGING_OPTIMIZER="adam"
LAYER_MERGING_LOSS="cross_entropy"

# ---- Similarity / manifold (MKA paper) --------------------------------------
LAYER_MERGING_N_MANIFOLD_DIMS=8
LAYER_MERGING_DIFFUSION_TIME=1
LAYER_MERGING_KERNEL_SIGMA=3.0
LAYER_MERGING_N_CALIBRATION_SAMPLES=512

# ---- Merging ----------------------------------------------------------------
LAYER_MERGING_MERGE_MIN_ALPHA=0.1
LAYER_MERGING_MERGE_MAX_ALPHA=0.9
LAYER_MERGING_MERGE_THRESHOLD=0.05
LAYER_MERGING_MERGE_STRATEGIES="(\"weighted\", \"uniform\", \"slerp\")"

# ---- Pruning (SparC3 paper) ---------------------------------------------------
LAYER_MERGING_LRP_EPS=1e-2
LAYER_MERGING_PRUNE_KEEP_RATIO=0.5
LAYER_MERGING_PRUNE_SWEEP="(1.0, 0.9, 0.75, 0.5, 0.3, 0.1)"
LAYER_MERGING_PRUNE_METHODS="(\"lrp\", \"magnitude\", \"random\")"
LAYER_MERGING_RANDOM_SEED=0

# ---- Project paths (anchored to the project root) -----------------------------
LAYER_MERGING_ARTIFACTS_DIR="artifacts"